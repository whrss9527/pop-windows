<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <!-- 文字识别（Windows.Media.Ocr）要用 WinRT 接口；最低支持 Windows 10 1809 -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>Pop</RootNamespace>
    <AssemblyName>Pop</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Pop.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- 发布成一个自带运行时的 Pop.exe，用户不用另装 .NET；一键更新也只替换这一个文件 -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- 轻量版以 SelfContained=false 发布，复用已安装的 .NET 8 桌面运行时；SDK 不支持压缩这种单文件。 -->
    <EnableCompressionInSingleFile>$(SelfContained)</EnableCompressionInSingleFile>
    <DefineConstants Condition="'$(SelfContained)' != 'true'">$(DefineConstants);POP_LIGHTWEIGHT</DefineConstants>
    <!-- 发布时预先编译成机器码：第一次弹出圆盘、卡片时不用现场编译，慢的机器上也不会卡一下。
         只编译界面相关的程序集，见下面的 PublishReadyToRunExclude -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- 单文件发布默认把整个运行时一起重新编译成一大块，会大 20 MB；运行时本身已经预编译过，只编译自己的就够了 -->
    <PublishReadyToRunComposite>false</PublishReadyToRunComposite>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <!-- 截屏和图片标注使用 GDI+；无需同时携带 WinForms 界面框架 -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.31" />
    <Resource Include="Assets\Pop.ico" />
    <!-- 中文字体：Noto Sans CJK SC 的常用字子集（SIL Open Font License） -->
    <Resource Include="Assets\Fonts\*.otf" />
    <Resource Include="Assets\Fonts\LICENSE-OFL.txt" />
  </ItemGroup>
  <ItemGroup>
    <!-- 这几个预先编译后会大很多（Windows SDK 的接口大 30 MB 以上），又不在弹出圆盘和卡片的路上：
         文字识别、JavaScript 插件第一次用时现场编译 -->
    <PublishReadyToRunExclude Include="Microsoft.Windows.SDK.NET.dll" />
    <PublishReadyToRunExclude Include="WinRT.Runtime.dll" />
    <PublishReadyToRunExclude Include="Jint.dll" />
    <PublishReadyToRunExclude Include="Acornima.dll" />
  </ItemGroup>
  <ItemGroup>
    <!-- Windows 原生 UI Automation（UIAutomationCore）的 COM 接口 -->
    <PackageReference Include="Interop.UIAutomationClient" Version="10.19041.0" />
    <!-- Fluent 风格的控件、Mica 窗口和图标（MIT） -->
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <!-- 用 Windows 的数据保护接口加密保存 Key -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Pop.Core\Pop.Core.csproj" />
  </ItemGroup>
  <!-- .NET 8 的桌面运行时包仍包含 WinForms，WPF 应用也会被默认整包复制。
       本项目已使用原生托盘和屏幕 API，仅排除不再使用的 WinForms 专属程序集与资源。 -->
  <Target Name="RemoveUnusedWinFormsRuntime" AfterTargets="ResolveRuntimePackAssets">
    <ItemGroup>
      <UnusedWinFormsAsset Include="@(RuntimePackAsset)"
        Condition="$([System.String]::Copy('%(RuntimePackAsset.Filename)').StartsWith('System.Windows.Forms')) Or $([System.String]::Copy('%(RuntimePackAsset.Filename)').StartsWith('Microsoft.VisualBasic.Forms')) Or $([System.String]::Copy('%(RuntimePackAsset.Filename)').StartsWith('WindowsFormsIntegration'))" />
      <RuntimePackAsset Remove="@(UnusedWinFormsAsset)" />
      <ReferenceCopyLocalPaths Remove="@(UnusedWinFormsAsset)" />
    </ItemGroup>
  </Target>
</Project>
