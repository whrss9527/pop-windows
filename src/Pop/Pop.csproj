<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <!-- 文字识别（Windows.Media.Ocr）要用 WinRT 接口；最低支持 Windows 10 1809 -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- 只用到托盘图标 -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Pop</RootNamespace>
    <AssemblyName>Pop</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Pop.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- 发布成一个自带运行时的 Pop.exe，用户不用另装 .NET；一键更新也只替换这一个文件 -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <!-- 高 DPI 设置写在 app.manifest 里（WPF 靠它按显示器缩放），WinForms 的检查会误报 -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- WPF 和 WinForms 有很多同名类型，不用全局引入 WinForms -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Pop.ico" />
    <!-- 中文字体：Noto Sans CJK SC 的常用字子集（SIL Open Font License） -->
    <Resource Include="Assets\Fonts\*.otf" />
    <Resource Include="Assets\Fonts\LICENSE-OFL.txt" />
  </ItemGroup>
  <ItemGroup>
    <!-- Windows 原生 UI Automation（UIAutomationCore）的 COM 接口 -->
    <PackageReference Include="Interop.UIAutomationClient" Version="10.19041.0" />
    <!-- Fluent 风格的控件、Mica 窗口和图标（MIT） -->
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <!-- 用 Windows 的数据保护接口加密保存 Key -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Pop.Core\Pop.Core.csproj" />
  </ItemGroup>
</Project>
