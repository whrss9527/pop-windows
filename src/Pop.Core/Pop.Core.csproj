<Project Sdk="Microsoft.NET.Sdk">
  <!-- 和系统无关的逻辑：长按判定、圆盘几何、版本和发布信息、校验和、剪贴板历史、自定义插件。单元测试在任何系统上都能跑 -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Pop.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- 剪贴板历史的数据库；自带 SQLite 原生库（Windows、Linux 都有），单文件发布时一起打进 Pop.exe -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.31" />
    <!-- 自定义插件的 JavaScript 解释器：纯托管代码，能限制运行时间，递归太深时抛出能接住的错误而不是让整个进程崩溃 -->
    <PackageReference Include="Jint" Version="4.16.4" />
  </ItemGroup>
</Project>
